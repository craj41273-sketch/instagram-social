# ---------------------------------------------------------------------------
# Application (public — may be read by browser code)
# ---------------------------------------------------------------------------
# Local base URL used for Supabase email redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Neon PostgreSQL (SERVER-ONLY — never prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# From Neon Console > Connection details > Connection string (pooled).
DATABASE_URL=postgresql://user:password@host.neon.tech:5432/database?sslmode=require

# ---------------------------------------------------------------------------
# Supabase Auth (public values — safe for the browser)
# ---------------------------------------------------------------------------
# From Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---------------------------------------------------------------------------
# Supabase service role (SERVER-ONLY — bypasses RLS; never expose to browser)
# ---------------------------------------------------------------------------
# From Supabase Dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# - Copy this file to .env.local and fill in real values. .env* is gitignored.
# - All four service values above are required for full Blocks 4–5 functionality,
#   including real profile queries, follow mutations, and authenticated search.
# - Storage buckets are planned as constants in lib/storage/index.ts:
#   avatars, post-media, stories, message-attachments. No bucket is created
#   or made public automatically; there is no storage environment variable.
